{
  "name": "github-comment-cli",
  "version": "0.1.0",
  "description": "Post Markdown PR comments with verified, commit-pinned local code references.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronS7/github-comment-cli.git"
  },
  "homepage": "https://aarons7.github.io/github-comment-cli/",
  "bugs": {
    "url": "https://github.com/aaronS7/github-comment-cli/issues"
  },
  "keywords": [
    "github",
    "pull-request",
    "code-review",
    "comments",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gh-comment": "bin/gh-comment.js"
  },
  "files": [
    "bin/",
    "build/src/",
    "build/mint-app-token.js",
    "build/config-ui-server.js",
    "examples/",
    "README.md",
    "llms.txt",
    ".agents/",
    "mint-app-token.mjs",
    "config-ui-server.mjs"
  ],
  "scripts": {
    "gh-comment:app": "node mint-app-token.mjs",
    "mint-app-token": "node mint-app-token.mjs",
    "app-config-ui": "node config-ui-server.mjs",
    "app-config-ui:code": "node config-ui-server.mjs --show-code",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test mint-app-token.ts config-ui-server.ts tools",
    "build:binary": "npm run build && node tools/build-binary.mjs",
    "smoke:binary": "node tools/smoke-binary.mjs",
    "smoke:package": "node tools/smoke-package.mjs",
    "test": "npm run build && node --test \"build/test/*.test.js\"",
    "test:bun": "npm run build && bun test build/test",
    "test:deno": "npm run build && deno test -A build/test",
    "check": "npm run typecheck && npm run lint && node --check bin/gh-comment.js && node --check mint-app-token.mjs && node --check config-ui-server.mjs",
    "prepare": "npm run build",
    "prepack": "npm run check && npm test"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "marked": "^18.0.14",
    "mdast-util-from-markdown": "^2.0.2",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/sanitize-html": "^2.16.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
